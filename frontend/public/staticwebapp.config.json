{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    { "route": "/api/roles", "allowedRoles": ["anonymous"] },
    { "route": "/api/health", "allowedRoles": ["anonymous"] },
    { "route": "/api/access-request", "allowedRoles": ["authenticated"] },
    { "route": "/api/access-requests", "allowedRoles": ["admin"] },
    { "route": "/api/access-decision", "allowedRoles": ["admin"] },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/admin", "allowedRoles": ["admin"] },
    { "route": "/admin/*", "allowedRoles": ["admin"] },
    { "route": "/app", "allowedRoles": ["approved", "admin"] },
    { "route": "/app/*", "allowedRoles": ["approved", "admin"] }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/.auth/*",
      "/api/*",
      "/*.{css,js,json,svg,png,jpg,jpeg,gif,ico,webp,woff,woff2}"
    ]
  },
  "responseOverrides": {
    "401": { "rewrite": "/index.html", "statusCode": 200 },
    "403": { "rewrite": "/index.html", "statusCode": 200 },
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  },
  "auth": {
    "rolesSource": "/api/roles",
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/common/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      },
      "google": {
        "registration": {
          "clientIdSettingName": "GOOGLE_CLIENT_ID",
          "clientSecretSettingName": "GOOGLE_CLIENT_SECRET"
        }
      }
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
